# HortusClavis — local development environment
#
# Ports are offset from the standard ones so DevCadence (3000/5432/6379) can run
# at the same time: app 8001, postgres 5433, redis 6380.
# Compose reads POSTGRES_* directly (docker/podman compose loads .env).
# They are required: docker-compose.yml has no fallback, so `make deps-up`
# fails loudly if they are missing instead of starting with a guessable password.
# Use the same values IAM_DATABASE_URL points at below.
POSTGRES_DB=jardinero
POSTGRES_USER=jardinero
POSTGRES_PASSWORD=change-me-local-dev-password

# Used by `make dev` from your shell (host port 5433).
IAM_DATABASE_URL=postgresql+asyncpg://jardinero:change-me-local-dev-password@localhost:5433/jardinero
# Used by the iam container in compose (service DNS name "postgres").
IAM_DATABASE_URL_DOCKER=postgresql+asyncpg://jardinero:change-me-local-dev-password@postgres:5432/jardinero
IAM_REDIS_URL=redis://localhost:6380/0
IAM_JWT_SECRET=change-me-to-a-random-64-char-string-in-production
IAM_JWT_EXPIRATION=7200
IAM_OIDC_ENABLED=true
IAM_OIDC_ISSUER=http://localhost:8001
IAM_OIDC_ACCESS_TOKEN_EXPIRATION=900
IAM_OIDC_REFRESH_TOKEN_EXPIRATION=2592000
IAM_OIDC_AUTHORIZATION_CODE_EXPIRATION=300
IAM_OIDC_SESSION_EXPIRATION=3600
IAM_OIDC_SIGNING_KEY_BITS=2048
IAM_DEBUG=false
IAM_BOOTSTRAP_ADMIN_EMAIL=admin@jardinbinario.com
IAM_BOOTSTRAP_ADMIN_PASSWORD=admin

# Compose volume names (read by docker/podman compose, ignored by the app).
# Set these to adopt an existing data volume instead of a fresh one:
#   podman volume ls
#   HC_PG_VOLUME=<existing-postgres-volume> HC_REDIS_VOLUME=<existing-redis-volume>
HC_PG_VOLUME=hortusclavis_pgdata
HC_REDIS_VOLUME=hortusclavis_redisdata
